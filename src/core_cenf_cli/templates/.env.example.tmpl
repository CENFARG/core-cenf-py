# {{ project_name }} — Environment Variables
# Copy to .env and fill in your values.
# DO NOT commit .env to version control.

# Core settings
CENF_APP_NAME={{ project_name }}
CENF_ENV=dev
CENF_LOG_LEVEL=INFO

# Secrets (use SecretManager for production)
CENF_SECRETS_BACKEND=local
CENF_AUTH_SIGNING_KEY=change-me-in-production

# Database (override if not using SQLite)
# CENF_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/{{ project_name }}

# Observability (set to enable OTLP export)
# CENF_OBSERVABILITY_EXPORTER_ENDPOINT=http://localhost:4317

# Feature flags (set to enable Unleash)
# CENF_FEATURE_FLAGS_UNLEASH_URL=http://localhost:4242/api

# Cache (set to enable Redis)
# CENF_CACHE_REDIS_URL=redis://localhost:6379
